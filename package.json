{
  "name": "convene",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "if [ -z \"$VERCEL\" ]; then lefthook install; fi"
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "playwright": "^1.60.0",
    "turbo": "^2",
    "ultracite": "7.9.3"
  },
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "tinypool": "2.1.2"
  },
  "packageManager": "npm@10.9.3"
}
